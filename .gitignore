# Dependencies
node_modules/

# Build outputs
build/
dist/
coverage/
playwright-report/
test-results/
.turbo/

# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example

# Binary files — never commit
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.bmp
*.webp
*.mp3
*.mp4
*.wav
*.flac
*.ogg
*.avi
*.mov
*.mkv
*.pdf
*.epub
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.zip
*.tar
*.gz
*.7z
*.rar
*.woff
*.woff2
*.ttf
*.eot
*.otf

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Windows reserved device names that Git cannot index
nul
aux
prn
con
lpt1
lpt2
lpt3
com1
com2
com3
com4
.idea/

# TypeScript
*.tsbuildinfo

# Supabase local artifacts
supabase/.branches
supabase/.temp
