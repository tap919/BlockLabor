    "express-rate-limit": "7.1.5",
    "express-validator": "7.0.1",
    "helmet": "7.1.0",
    "http-proxy-middleware": "2.0.7",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "node-cache": "5.1.2",
    "prom-client": "15.1.0",
    "uuid": "9.0.1",
    "ws": "8.17.1",
    "@modelcontextprotocol/sdk": "^1.12.1"
