    "homepage": "https://github.com/yourusername/overcoat",
    "repository": "yourusername/overcoat"
  },
  "stack": {
    "core": {
      "language": "Rust",
      "framework": "actix-web",
      "runtime": "tokio"
    },
    "sandbox": {
      "primary": "WASM (wasmtime)",
      "optional": "Docker"
    },
    "llm": {
      "providers": [
        "Ollama",
        "DeepSeek",
        "Gemini",
        "GitHub Copilot",
        "OpenAI",
        "Any OpenAI-compatible endpoint"
      ],
      "integration": "Multi-provider router with unified interface"
    },
    "indexing": {
      "parser": "tree-sitter",
      "vector_db": "sqlite-vec (embedded) / Qdrant",
      "search": "Hybrid (full-text + embeddings)"
    },
    "ui": {
      "desktop": "Tauri",
      "ide_plugin": "WebSocket (VSCode / Cursor / Zed) + HTTP (JetBrains / PyCharm)"
    },
    "storage": {
      "database": "SQLite",
      "provenance": "git"
    }
  },
  "features": {
    "agentic_coding": [
      "Repo graph + symbol search",
      "Multi-file edit with hunk approval",
      "Test/debug loops (run-fail-patch-repeat)",
      "Refactor/migrate campaigns with git checkpoints",
      "Docs/PR generation from diffs"
    ],
    "background_agents": [
      "24/7 agent queues (background tasks, automation)",
      "Persistent TODO hunter",
      "Tech debt scanner",
      "Automated dependency updates",
      "Background refactoring suggestions"
    ],
    "overcoat_exclusives": [
      "Dynamic WASM tool builder",
      "Multi-LLM routing + fusion",
      "Low-spec mode (2GB RAM optimized)",
      "Persistent health agents"
    ],
    "marathon_coding": [
      "Automatic session checkpoints every 30 minutes",
      "Break reminders every 90 minutes",
      "Session statistics: duration, tokens, files modified",
      "Context continuity across interruptions",
      "Session summary export to .overcoat/sessions/"
    ],
    "completion_cache": [
      "LRU cache with configurable maxSize and TTL",
      "Deduplicates identical requests (same messages + model + temperature)",
      "getOrFetch() helper wraps any completion function",
      "Hit/miss/eviction statistics via getStats()",
      "purgeExpired() for manual TTL sweep"
    ],
    "context_compression": [
      "Exact-duplicate message removal",
      "Per-message truncation with configurable maxMessageChars",
      "Token-budget trimming (drops oldest user/assistant pairs)",
      "System messages always preserved",
      "Lightweight char-based token estimation (no external tokeniser needed)"
    ],
    "code_quality": [
      "Pattern-based scorer for TypeScript, JavaScript, Python, Go, Java, Rust",
      "Detects: empty catches, TODO markers, eval(), hardcoded secrets, any types, debug logging",
      "Returns 0-100 score plus issue list with severity and line number",
      "CI-style passes() gate with configurable severity threshold",
      "Language detection from file extension or code heuristics"
    ]
  },
  "architecture": {
    "channels": [
      "REPL (CLI)",
      "WebSocket (IDE)",
      "HTTP API (remote agents)",
