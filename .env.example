# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry
VITE_SENTRY_DSN=your_sentry_dsn

# Dropbox Sign (HelloSign)
DROPBOX_SIGN_API_KEY=your_dropbox_sign_api_key
DROPBOX_SIGN_CLIENT_ID=your_dropbox_sign_client_id

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

# Checkr
CHECKR_API_KEY=your_checkr_api_key
CHECKR_WEBHOOK_SECRET=your_checkr_webhook_secret

# Okta
OKTA_DOMAIN=your_okta_domain.okta.com
OKTA_CLIENT_ID=your_okta_client_id
OKTA_CLIENT_SECRET=your_okta_client_secret
OKTA_REDIRECT_URI=http://localhost:3000/api/functions/v1/okta/login/callback

# QuickBooks
QUICKBOOKS_ACCESS_TOKEN=your_quickbooks_access_token
QUICKBOOKS_REALM_ID=your_quickbooks_realm_id
QUICKBOOKS_COMPANY_ID=your_quickbooks_company_id

# Gusto
GUSTO_API_KEY=your_gusto_api_key

# Frontend
FRONTEND_URL=http://localhost:3000
DROPBOX_SIGN_TEST_MODE=false

# ============================================
# OVERLAY365 TRUTH-VERIFIED LABOR EXCHANGE
# ============================================
# These vars are read by the Supabase Edge Functions that run the
# verification cron jobs and the call-completion webhook.

# Aetherdesk API base URL (outbound calls from BlockLabor).
# Local dev: http://localhost:8000
# Production: https://api.aetherdesk.com
AETHERDESK_URL=http://localhost:8000

# Service-to-service auth token. Must match AETHERDESK_API_KEY on Aetherdesk.
AETHERDESK_API_KEY=

# Default outbound phone used by ghost-job-audit and application-sla-monitor
# edge functions when a real business phone is not yet resolvable. This is
# a cold-start fallback; production deployments should add a real
# businesses-table join before relying on verification calls.
OVERLAY365_DEFAULT_AUDIT_PHONE=+15555550000

